# ---- Core ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swipe
# Unpooled URL for migrations. On Vercel + Neon: DATABASE_URL = pooled URL, DATABASE_URL_UNPOOLED = direct URL (Vercel's Neon add-on sets both).
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/swipe
APP_URL=http://localhost:3000
# 32-byte base64 key used to encrypt OAuth tokens at rest (AES-256-GCM). `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
# HMAC secret for signed media URLs and OAuth state. `openssl rand -hex 32`
APP_SECRET=
# Enables clearly-labelled sandbox ("Demo") accounts whose publishing is simulated. Never enable in production.
DEMO_MODE=false
# Secret the scheduler sends to /api/cron/tick (Vercel Cron sends it automatically). `openssl rand -hex 32`
CRON_SECRET=
# Comma-separated emails granted the platform admin console
PLATFORM_ADMIN_EMAILS=

# ---- Media storage ----
# Leave S3_BUCKET empty for local disk (./storage, single instance only). For production use S3 or Cloudflare R2:
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional public CDN base for media (needed for TikTok PULL_FROM_URL domain verification), e.g. https://media.example.com
MEDIA_PUBLIC_BASE_URL=

# ---- AI (Claude) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="Swipe <notifications@example.com>"

# ---- Billing (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_ANNUAL=

# ---- Social network apps (official developer apps; leave blank to show "not configured") ----
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:swipe:0.1 (by /u/your_reddit_username)
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
# Telegram uses per-account bot tokens entered in the UI (stored encrypted); no app-level secret required.
# WhatsApp Business uses a Meta System User token + phone number id entered in the UI.
